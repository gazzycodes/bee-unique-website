---
interface Props {
  tone?: "light" | "dark";
  class?: string;
}
const { tone = "light", class: className = "" } = Astro.props;

const tones = {
  light: "bg-honey/15 text-honey-dark",
  dark: "bg-honey/20 text-honey-light",
};
---

<span
  class:list={[
    "inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider",
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
