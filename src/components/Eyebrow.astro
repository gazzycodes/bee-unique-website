---
interface Props {
  tone?: "light" | "dark";
  class?: string;
}
const { tone = "light", class: className = "" } = Astro.props;

const tones = {
  light: "bg-brand-tint text-brand-deep ring-1 ring-brand/20",
  dark: "bg-white/10 text-brand-soft ring-1 ring-brand-soft/25",
};
---

<span
  class:list={[
    "inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-[0.12em]",
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
