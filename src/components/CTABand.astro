---
import Container from "./Container.astro";
import Button from "./Button.astro";

interface Props {
  heading: string;
  body: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  heading,
  body,
  primaryHref = "/get-involved",
  primaryLabel = "Join the Hive",
  secondaryHref = "/donate",
  secondaryLabel = "Donate Today",
} = Astro.props;
---

<section class="honeycomb-bg-dark py-16 sm:py-20">
  <Container class="text-center">
    <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">{heading}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-base text-white/75 sm:text-lg">{body}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={primaryHref}
        class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3.5 text-base font-semibold text-brand-forest transition-colors hover:bg-brand-soft"
      >
        {primaryLabel}
      </a>
      <Button href={secondaryHref} variant="outline-light" size="lg">{secondaryLabel}</Button>
    </div>
  </Container>
</section>
