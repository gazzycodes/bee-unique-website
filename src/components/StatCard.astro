---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="rounded-2xl border border-line bg-white p-6 text-center">
  <p class="font-display text-4xl font-bold text-brand-strong sm:text-5xl">{value}</p>
  <p class="mt-2 text-sm font-medium text-ink-soft">{label}</p>
</div>
