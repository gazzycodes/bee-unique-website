---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="rounded-2xl bg-white/60 p-6 text-center shadow-sm ring-1 ring-charcoal/5">
  <p class="font-display text-4xl font-semibold text-honey-dark sm:text-5xl">{value}</p>
  <p class="mt-2 text-sm font-medium text-charcoal/75">{label}</p>
</div>
