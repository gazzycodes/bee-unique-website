---
import { gallery } from "../gallery";

/**
 * Full screen media viewer, rendered once per page that needs it.
 *
 * Anything on the page with `data-lightbox="<item id>"` opens it, so the hero
 * mosaic, the gallery grid and one off images all share the same viewer and the
 * same next/previous ordering.
 *
 * Accessibility notes, because a homemade modal usually gets these wrong:
 *   - it is a real <dialog>, so Esc and the top layer come for free
 *   - focus moves in on open and returns to the trigger on close
 *   - arrow keys move between items, and the counter is announced politely
 *   - the whole thing degrades to nothing if JS is off, because every trigger
 *     is still a normal image sitting in the page
 */
const items = gallery;
---

<dialog
  id="lightbox"
  class="max-h-none max-w-none bg-transparent p-0 backdrop:bg-brand-forest/92 backdrop:backdrop-blur-sm"
  aria-label="Photo and video viewer"
>
  <div class="fixed inset-0 flex flex-col">
    <!-- Top bar -->
    <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <p class="text-sm font-semibold text-white/80">
        <span id="lightbox-index" aria-live="polite">1</span>{" "}
        <span class="text-white/45">of {items.length}</span>
      </p>
      <button
        id="lightbox-close"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition-colors hover:bg-white hover:text-brand-forest"
        aria-label="Close viewer"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <!-- Stage -->
    <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-16">
      <button
        id="lightbox-prev"
        class="absolute left-1 z-10 inline-flex h-12 w-12 items-center justify-center rounded-full border border-white/25 bg-brand-forest/60 text-white transition-colors hover:bg-white hover:text-brand-forest sm:left-4"
        aria-label="Previous item"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12.5 3.5 6 10l6.5 6.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div id="lightbox-stage" class="flex h-full max-h-full w-full items-center justify-center"></div>

      <button
        id="lightbox-next"
        class="absolute right-1 z-10 inline-flex h-12 w-12 items-center justify-center rounded-full border border-white/25 bg-brand-forest/60 text-white transition-colors hover:bg-white hover:text-brand-forest sm:right-4"
        aria-label="Next item"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7.5 3.5 14 10l-6.5 6.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <!-- Caption -->
    <div class="px-5 pb-6 pt-4 text-center sm:px-16">
      <p id="lightbox-caption" class="mx-auto max-w-2xl text-sm leading-relaxed text-white/85"></p>
      <p class="mt-2 text-xs text-white/40">Use the arrow keys to move between items, Esc to close.</p>
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ items }}>
  (() => {
    const dialog = document.getElementById("lightbox");
    if (!dialog || typeof dialog.showModal !== "function") return;

    const stage = document.getElementById("lightbox-stage");
    const caption = document.getElementById("lightbox-caption");
    const indexEl = document.getElementById("lightbox-index");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");
    const closeBtn = document.getElementById("lightbox-close");

    let current = 0;
    let opener = null;

    function render(i) {
      current = (i + items.length) % items.length;
      const item = items[current];
      stage.innerHTML = "";

      if (item.kind === "video") {
        const v = document.createElement("video");
        v.src = item.src;
        if (item.poster) v.poster = item.poster;
        v.controls = true;
        v.autoplay = true;
        v.loop = true;
        v.playsInline = true;
        v.setAttribute("aria-label", item.alt);
        v.className = "max-h-full max-w-full rounded-xl";
        stage.appendChild(v);
      } else {
        const img = document.createElement("img");
        // Largest width in the catalog is always the plain -1600/-1200 variant;
        // fall back through the sizes we actually generate.
        img.src = `/images/${item.src}-1600.webp`;
        img.onerror = () => {
          if (img.dataset.tried === "1200") {
            img.dataset.tried = "1000";
            img.src = `/images/${item.src}-1000.webp`;
          } else if (img.dataset.tried === "1000") {
            img.dataset.tried = "600";
            img.src = `/images/${item.src}-600.webp`;
          } else if (!img.dataset.tried) {
            img.dataset.tried = "1200";
            img.src = `/images/${item.src}-1200.webp`;
          }
        };
        img.alt = item.alt;
        img.className = "max-h-full max-w-full rounded-xl object-contain";
        stage.appendChild(img);
      }

      caption.textContent = item.caption;
      indexEl.textContent = String(current + 1);
    }

    function open(id, trigger) {
      const i = items.findIndex((it) => it.id === id);
      opener = trigger || null;
      render(i < 0 ? 0 : i);
      dialog.showModal();
      closeBtn.focus();
    }

    document.querySelectorAll("[data-lightbox]").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        open(el.getAttribute("data-lightbox"), el);
      });
    });

    prevBtn.addEventListener("click", () => render(current - 1));
    nextBtn.addEventListener("click", () => render(current + 1));
    closeBtn.addEventListener("click", () => dialog.close());

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        render(current + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        render(current - 1);
      }
    });

    // Clicking the backdrop closes. The inner panel stops the event, so clicks
    // on the image itself do not.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener("close", () => {
      stage.innerHTML = ""; // stop any playing video
      if (opener && typeof opener.focus === "function") opener.focus();
    });
  })();
</script>
