---
/**
 * Bee Unique lockup — the fading honeycomb field from the printed logo.
 *
 * The printed mark sets a green wordmark against a hex grid that fades out as
 * it recedes. This reproduces that: one solid cell anchoring the near corner,
 * then four outlined cells stepping down in opacity. Reproduced as vector
 * rather than lifting the source PNG, so it stays crisp at any size and can be
 * recoloured for dark backgrounds.
 *
 * The 1.6 stroke and the opacity ramp are tuned for ~36-48px. Below roughly
 * 28px the faintest cells stop resolving, which is why `public/favicon.svg`
 * carries a reduced three-cell version of the same shape rather than this one.
 *
 * Wordmark stays stacked on two lines, matching the printed lockup.
 */
interface Props {
  variant?: "dark" | "light";
  class?: string;
}
const { variant = "dark", class: className = "" } = Astro.props;

const isLight = variant === "light";
const wordColor = isLight ? "text-white" : "text-brand-strong";
const ink = isLight ? "#a7d9a0" : "#43943a";

/** Near corner first, then receding — opacity carries the depth. */
const cells = [
  { d: "M14 2 L24.4 8 L24.4 20 L14 26 L3.6 20 L3.6 8 Z", o: 1 },
  { d: "M14 28 L24.4 34 L24.4 46 L14 52 L3.6 46 L3.6 34 Z", o: 0.75 },
  { d: "M27 15 L37.4 21 L37.4 33 L27 39 L16.6 33 L16.6 21 Z", o: 0.55 },
  { d: "M40 2 L50.4 8 L50.4 20 L40 26 L29.6 20 L29.6 8 Z", o: 0.32 },
  { d: "M40 28 L50.4 34 L50.4 46 L40 52 L29.6 46 L29.6 34 Z", o: 0.16 },
];
---

<a
  href="/"
  class={`group flex items-center gap-3 shrink-0 ${className}`}
  aria-label="Bee Unique — home"
>
  <svg
    width="40"
    height="40"
    viewBox="0 0 54 54"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0 transition-transform duration-200 group-hover:-translate-y-0.5"
  >
    <g fill="none" stroke={ink} stroke-width="1.6" stroke-linejoin="round">
      {cells.map((c) => <path d={c.d} opacity={c.o} />)}
    </g>
    <path d={cells[0].d} fill={ink} />
  </svg>

  <span class={`font-display font-extrabold leading-[0.9] tracking-[-0.03em] ${wordColor}`}>
    <span class="block text-[1.12rem]">Bee</span>
    <span class="block text-[1.12rem]">Unique</span>
  </span>
</a>
