---
/**
 * Bee Unique lockup.
 *
 * The printed logo is a green wordmark over a fading honeycomb field. That
 * field turns to mush below ~40px, so the mark here distils it to two cells:
 * one filled hive cell with a negative-space centre, and one smaller cell
 * offset from it — the one standing apart from the hive. Same honeycomb
 * language, but it still reads at favicon size.
 *
 * Wordmark stays stacked on two lines, matching the printed lockup.
 */
interface Props {
  variant?: "dark" | "light";
  class?: string;
}
const { variant = "dark", class: className = "" } = Astro.props;

const isLight = variant === "light";
const wordColor = isLight ? "text-white" : "text-brand-strong";
const cellFill = isLight ? "#a7d9a0" : "var(--color-brand)";
const cellHole = isLight ? "#14361a" : "#ffffff";
const satellite = isLight ? "#ffffff" : "var(--color-brand-deep)";
---

<a
  href="/"
  class={`group flex items-center gap-2.5 shrink-0 ${className}`}
  aria-label="Bee Unique — home"
>
  <svg
    width="37"
    height="40"
    viewBox="0 0 48 52"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0 transition-transform duration-200 group-hover:-translate-y-0.5"
  >
    <path d="M18 4 L33 12.6 L33 29.8 L18 38.4 L3 29.8 L3 12.6 Z" fill={cellFill} />
    <path d="M18 13 L25.5 17.3 L25.5 25.9 L18 30.2 L10.5 25.9 L10.5 17.3 Z" fill={cellHole} />
    <path d="M37 27 L45 31.6 L45 40.8 L37 45.4 L29 40.8 L29 31.6 Z" fill={satellite} />
  </svg>

  <span class={`font-display font-extrabold leading-[0.9] tracking-[-0.03em] ${wordColor}`}>
    <span class="block text-[1.12rem]">Bee</span>
    <span class="block text-[1.12rem]">Unique</span>
  </span>
</a>
