---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "outline" | "outline-light";
  size?: "md" | "lg";
  class?: string;
}
const { href, variant = "primary", size = "md", class: className = "" } = Astro.props;

const isExternal = href.startsWith("http");

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-strong";

const sizes = {
  md: "px-6 py-2.5 text-sm",
  lg: "px-8 py-3.5 text-base",
};

const variants = {
  primary: "bg-brand-strong text-white hover:bg-brand-deep",
  secondary: "bg-white text-brand-strong ring-1 ring-line hover:bg-brand-tint",
  outline: "border-2 border-brand-strong text-brand-strong hover:bg-brand-strong hover:text-white",
  "outline-light": "border-2 border-white/70 text-white hover:bg-white hover:text-brand-forest",
};
---

<a
  href={href}
  class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <slot />
</a>
