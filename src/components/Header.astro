---
import Logo from "./Logo.astro";
import Button from "./Button.astro";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About Us" },
  { href: "/programs", label: "Programs & Impact" },
  { href: "/get-involved", label: "Get Involved" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex h-20 items-center justify-between py-3">
      <Logo />

      <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "text-sm font-semibold tracking-wide transition-colors hover:text-brand-strong",
                isActive(link.href) ? "text-brand-strong" : "text-ink",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <Button href="/donate" variant="primary" class="hidden sm:inline-flex">Donate</Button>
        <button
          id="mobile-menu-toggle"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line text-ink lg:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 5H18M2 10H18M2 15H18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <svg id="icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="hidden">
            <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden">
    <nav class="flex flex-col gap-1 px-5 py-4" aria-label="Mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "rounded-lg px-3 py-2.5 text-base font-semibold",
              isActive(link.href) ? "bg-brand-tint text-brand-deep" : "text-ink",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/donate"
        class="mt-2 rounded-full bg-brand-strong px-3 py-2.5 text-center text-base font-semibold text-white"
      >
        Donate
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!!isHidden));
  });
</script>
