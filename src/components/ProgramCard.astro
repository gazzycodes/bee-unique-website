---
interface Props {
  name: string;
  audience: string;
  description: string;
  href?: string;
}
const { name, audience, description, href = "/programs" } = Astro.props;
---

<div class="flex flex-col rounded-2xl bg-white p-7 shadow-sm ring-1 ring-charcoal/5 transition-shadow hover:shadow-md">
  <span class="text-xs font-bold uppercase tracking-wider text-teal">{audience}</span>
  <h3 class="mt-2 font-display text-xl font-semibold text-charcoal">{name}</h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-charcoal/70">{description}</p>
  <a href={href} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-honey-dark hover:text-honey">
    Learn more
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 7H12M12 7L7.5 2.5M12 7L7.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</div>
