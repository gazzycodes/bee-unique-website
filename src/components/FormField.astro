---
interface Props {
  label: string;
  name: string;
  type?: "text" | "email" | "tel" | "textarea" | "select";
  required?: boolean;
  options?: string[];
  placeholder?: string;
  class?: string;
}
const {
  label,
  name,
  type = "text",
  required = false,
  options = [],
  placeholder = "",
  class: className = "",
} = Astro.props;

const fieldClasses =
  "w-full rounded-lg border border-line bg-white px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30";
---

<div class={className}>
  <label for={name} class="mb-1.5 block text-sm font-semibold text-ink">
    {label}{required && <span class="text-brand-strong"> *</span>}
  </label>
  {
    type === "textarea" ? (
      <textarea id={name} name={name} required={required} placeholder={placeholder} rows="4" class={fieldClasses} />
    ) : type === "select" ? (
      <select id={name} name={name} required={required} class={fieldClasses}>
        <option value="" disabled selected>
          Select an option
        </option>
        {options.map((o) => (
          <option value={o}>{o}</option>
        ))}
      </select>
    ) : (
      <input id={name} type={type} name={name} required={required} placeholder={placeholder} class={fieldClasses} />
    )
  }
</div>
