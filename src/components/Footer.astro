---
import Logo from "./Logo.astro";

const currentYear = new Date().getFullYear();

const explore = [
  { href: "/about", label: "About Us" },
  { href: "/programs", label: "Programs & Impact" },
  { href: "/get-involved", label: "Get Involved" },
  { href: "/donate", label: "Donate" },
];

const more = [
  { href: "/events", label: "Events" },
  { href: "/news", label: "News" },
  { href: "/contact", label: "Contact" },
  { href: "/financial-transparency", label: "Financial Transparency" },
  { href: "/privacy-policy", label: "Privacy Policy" },
];
---

<footer class="bg-charcoal text-cream">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 py-14">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo variant="light" />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-cream/70">
          Helping Texas youth discover their strengths, build confidence, and become who they were created to be.
        </p>
        <ul class="mt-5 flex items-center gap-3">
          {
            [
              { label: "Facebook", href: "https://facebook.com/[BEE_UNIQUE_HANDLE]" },
              { label: "Instagram", href: "https://instagram.com/[BEE_UNIQUE_HANDLE]" },
              { label: "LinkedIn", href: "https://linkedin.com/company/[BEE_UNIQUE_HANDLE]" },
            ].map((social) => (
              <li>
                <a
                  href={social.href}
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-cream/25 text-xs font-semibold text-cream/80 transition-colors hover:border-honey hover:text-honey"
                  aria-label={social.label}
                >
                  {social.label.slice(0, 2)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-honey-light">Explore</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-cream/75">
          {explore.map((l) => (
            <li><a href={l.href} class="hover:text-white">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-honey-light">More</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-cream/75">
          {more.map((l) => (
            <li><a href={l.href} class="hover:text-white">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-4">
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-honey-light">Stay Connected</h3>
        <address class="mt-4 space-y-1.5 text-sm not-italic text-cream/75">
          <p>Serving communities across Texas</p>
          <p><a href="mailto:[INFO@BEEUNIQUE.ORG]" class="hover:text-white">[info@beeunique.org]</a></p>
          <p><a href="tel:[555-555-5555]" class="hover:text-white">[(555) 555-5555]</a></p>
        </address>

        <form
          name="newsletter"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="mt-5"
        >
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
          <label for="footer-email" class="text-sm font-semibold text-cream/90">Join the Hive — get program updates</label>
          <div class="mt-2 flex gap-2">
            <input
              id="footer-email"
              type="email"
              name="email"
              required
              placeholder="you@example.com"
              class="min-w-0 flex-1 rounded-full border border-cream/25 bg-charcoal-light/50 px-4 py-2.5 text-sm text-cream placeholder:text-cream/40 focus:border-honey focus:outline-none"
            />
            <button
              type="submit"
              class="shrink-0 rounded-full bg-honey px-5 py-2.5 text-sm font-semibold text-charcoal transition-colors hover:bg-honey-dark"
            >
              Sign Up
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="mt-12 border-t border-cream/15 pt-6 text-xs text-cream/60">
      <p>
        Bee Unique is a Texas-based 501(c)(3) nonprofit organization. [EIN / tax-exempt status pending confirmation].
        Donations may be tax-deductible to the extent allowed by law.
      </p>
      <p class="mt-2">© {currentYear} Bee Unique. All rights reserved.</p>
    </div>
  </div>
</footer>
