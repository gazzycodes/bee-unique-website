---
interface Fact {
  label: string;
  value: string;
}
interface Props {
  name: string;
  summary: string;
  facts: Fact[];
  outcome: string;
  reverse?: boolean;
}
const { name, summary, facts, outcome, reverse = false } = Astro.props;
---

<div class="grid grid-cols-1 gap-8 lg:grid-cols-5 lg:items-start">
  <div class:list={["lg:col-span-3", reverse ? "lg:order-2" : "lg:order-1"]}>
    <h3 class="font-display text-2xl font-semibold text-charcoal sm:text-3xl">{name}</h3>
    <p class="mt-4 leading-relaxed text-charcoal/75">{summary}</p>
    <div class="mt-6 rounded-xl bg-teal/10 p-5">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-dark">Expected Outcome</p>
      <p class="mt-1.5 text-sm leading-relaxed text-charcoal/75">{outcome}</p>
    </div>
  </div>
  <div class:list={["lg:col-span-2", reverse ? "lg:order-1" : "lg:order-2"]}>
    <dl class="divide-y divide-charcoal/10 rounded-2xl bg-white shadow-sm ring-1 ring-charcoal/5">
      {
        facts.map((f) => (
          <div class="flex justify-between gap-4 px-5 py-3.5 text-sm">
            <dt class="font-semibold text-charcoal/60">{f.label}</dt>
            <dd class="text-right text-charcoal">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>
