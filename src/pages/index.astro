---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ProgramCard from "../components/ProgramCard.astro";
import CTABand from "../components/CTABand.astro";
import Photo from "../components/Photo.astro";
import VideoCard from "../components/VideoCard.astro";
import { site, programIncludes } from "../site";

const programs = [
  {
    name: "College Tours & Campus Visits",
    audience: "Exposure",
    description:
      "Students visit top colleges and universities, walk the campuses, and talk with current students and staff about what the experience is really like.",
  },
  {
    name: "College Readiness Workshops",
    audience: "Preparation",
    description:
      "Practical sessions on admissions, financial aid, and scholarships — so students and families know the steps long before senior year.",
  },
  {
    name: "Mentorship & Personalized Support",
    audience: "Consistency",
    description:
      "Ongoing mentorship and one-to-one guidance that stays with a student through the whole process, not just a single event.",
  },
];
---

<Layout
  title="Home"
  description="Bee Unique is a 501(c)(3) nonprofit empowering youth through mentorship, education, and meaningful opportunities — college readiness, college tours, scholarships and community outreach, at no cost to students."
>
  <!-- Hero -->
  <section class="honeycomb-bg overflow-hidden border-b border-line">
    <Container class="grid grid-cols-1 items-center gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:py-24">
      <div>
        <Eyebrow>501(c)(3) Nonprofit · {site.serviceArea}</Eyebrow>
        <h1 class="mt-5 font-display text-4xl font-extrabold leading-[1.05] text-ink sm:text-5xl lg:text-6xl">
          Bee-lieve <span class="text-brand-strong">&amp;</span> Achieve
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
          Bee Unique empowers youth through mentorship, education, and meaningful opportunities — helping students
          recognize their potential, prepare for their future, and confidently pursue higher education and career
          goals.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/get-involved" size="lg">Get Involved</Button>
          <Button href="/programs" variant="outline" size="lg">Explore Our Programs</Button>
        </div>
        <p class="mt-6 flex items-center gap-2 text-sm font-semibold text-brand-deep">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.6" />
            <path d="M6 10.2 L8.8 13 L14 7.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Every program is offered at no cost to participating students.
        </p>
      </div>

      <div class="relative">
        <div class="overflow-hidden rounded-3xl border border-line bg-white shadow-xl shadow-brand/10">
          <Photo
            name="college-tour-group"
            alt="Bee Unique students in College Tour shirts gathered together during a campus visit"
            sizes="(min-width: 1024px) 560px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
        <div
          class="absolute -bottom-5 -left-4 hidden rounded-2xl border border-line bg-white px-5 py-3 shadow-lg sm:block"
        >
          <p class="font-display text-sm font-bold text-brand-strong">{site.strapline}</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Mission -->
  <section class="py-16 sm:py-20">
    <Container class="grid grid-cols-1 gap-10 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <Eyebrow>Our Mission</Eyebrow>
        <h2 class="mt-4 font-display text-3xl font-bold text-ink">Your gateway to success</h2>
        <div class="section-divider mt-5"></div>
      </div>
      <div class="lg:col-span-2">
        <p class="text-xl leading-relaxed text-ink">
          To expose, educate, and equip students with the tools they need for a successful college journey.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          We provide ongoing mentorship, personalized support, and key resources to help students get accepted and
          prepared for college life. Don't wait until senior year to plan your future — now is the time to dream,
          prepare, and achieve.
        </p>
      </div>
    </Container>
  </section>

  <!-- Programs preview -->
  <section class="honeycomb-bg border-y border-line py-16 sm:py-20">
    <Container>
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <Eyebrow>What We Do</Eyebrow>
          <h2 class="mt-4 font-display text-3xl font-bold text-ink sm:text-4xl">Ways we help students thrive</h2>
        </div>
        <a href="/programs" class="whitespace-nowrap text-sm font-semibold text-brand-strong hover:text-brand-deep">
          View all programs →
        </a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
        {programs.map((p) => <ProgramCard {...p} />)}
      </div>
    </Container>
  </section>

  <!-- What's included -->
  <section class="py-16 sm:py-20">
    <Container class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <Eyebrow>The Bee Unique Program</Eyebrow>
        <h2 class="mt-4 font-display text-3xl font-bold text-ink sm:text-4xl">What's included</h2>
        <ul class="mt-8 space-y-4">
          {
            programIncludes.map((item) => (
              <li class="flex items-start gap-3">
                <svg width="22" height="22" viewBox="0 0 20 20" fill="none" class="mt-0.5 shrink-0 text-brand-strong" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.6" />
                  <path d="M6 10.2 L8.8 13 L14 7.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="text-base leading-relaxed text-ink">{item}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 rounded-2xl border-l-4 border-brand bg-brand-tint p-5">
          <p class="font-display text-lg font-bold text-brand-deep">Scholarships &amp; resources provided</p>
          <p class="mt-1 text-sm leading-relaxed text-ink-soft">
            Participation is free. Bee Unique covers the cost so a student's family budget is never the reason they
            miss out on the trip, the workshop, or the information.
          </p>
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <div class="mx-auto max-w-md overflow-hidden rounded-3xl border border-line shadow-lg">
          <Photo
            name="program-flyer"
            alt="Bee Unique program flyer: Bee-lieve and Achieve — Join the Bee Unique Program, your gateway to success"
            sizes="(min-width: 1024px) 440px, 100vw"
            class="w-full"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Moments -->
  <section class="honeycomb-bg border-y border-line py-16 sm:py-20">
    <Container>
      <div class="max-w-2xl">
        <Eyebrow>In the Community</Eyebrow>
        <h2 class="mt-4 font-display text-3xl font-bold text-ink sm:text-4xl">Moments from the hive</h2>
        <p class="mt-4 leading-relaxed text-ink-soft">
          College tours, readiness workshops, community outreach and back-to-school drives — here's what the work
          actually looks like.
        </p>
      </div>

      <!-- Every tile is one square unit tall; wide tiles span two columns at 2:1,
           so all rows line up regardless of the source photo's orientation. -->
      <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
        <div class="col-span-2 aspect-[2/1] overflow-hidden rounded-2xl border border-line">
          <Photo
            name="college-tour-campus"
            alt="Bee Unique students on a college tour, gathered outside a university stadium entrance"
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-2xl border border-line">
          <Photo
            name="founder-booth"
            alt="Bee Unique founder Monique Grant beside the program banner at a community event"
            sizes="(min-width: 1024px) 25vw, 50vw"
            class="h-full w-full object-cover object-[65%_38%]"
          />
        </div>
        <VideoCard
          src="/video/elevate-youth.mp4"
          poster="/images/elevate-youth-poster.webp"
          label="Bee Unique at the Elevate Youth education conference"
          class="aspect-square"
        />
        <div class="aspect-square overflow-hidden rounded-2xl border border-line">
          <Photo
            name="team-portrait"
            alt="Two members of the Bee Unique team at a community education event"
            sizes="(min-width: 1024px) 25vw, 50vw"
            class="h-full w-full object-cover object-[50%_28%]"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-2xl border border-line">
          <Photo
            name="student-outreach"
            alt="A Bee Unique volunteer registering a student at an information table"
            sizes="(min-width: 1024px) 25vw, 50vw"
            class="h-full w-full object-cover object-[45%_52%]"
          />
        </div>
        <div class="col-span-2 aspect-[2/1] overflow-hidden rounded-2xl border border-line">
          <Photo
            name="outreach-table"
            alt="Students gathered around the Bee Unique information table at a school event"
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="h-full w-full object-cover object-[50%_40%]"
          />
        </div>
      </div>
    </Container>
  </section>

  <CTABand
    heading="Every student has something unique to offer"
    body="Volunteer, mentor a student, donate, sponsor a program or event, or partner with us. Every contribution helps us reach more students with the resources and experiences they need to thrive."
    primaryLabel="Get Involved"
    primaryHref="/get-involved"
  />
</Layout>
