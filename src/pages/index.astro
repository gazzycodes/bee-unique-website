---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import StatCard from "../components/StatCard.astro";
import ProgramCard from "../components/ProgramCard.astro";
import Testimonial from "../components/Testimonial.astro";
import CTABand from "../components/CTABand.astro";
import HoneycombArt from "../components/HoneycombArt.astro";

const programs = [
  {
    name: "Mentorship Circles",
    audience: "Ages [8–13]",
    description:
      "Small-group mentoring that pairs youth with trained adult mentors for consistent, one-on-one encouragement.",
  },
  {
    name: "Leadership Workshops",
    audience: "Ages [14–18]",
    description:
      "Hands-on workshops that build confidence, communication, and decision-making skills for teens stepping into leadership.",
  },
  {
    name: "Community Enrichment Days",
    audience: "All ages",
    description:
      "Family-friendly events held across Texas communities that connect youth with mentors, resources, and each other.",
  },
];

const events = [
  { date: "[Mar TBD, 2026]", title: "[Spring Mentorship Kickoff]", location: "[City], TX" },
  { date: "[Apr TBD, 2026]", title: "[Leadership Workshop Series]", location: "[City], TX" },
  { date: "[May TBD, 2026]", title: "[Community Enrichment Day]", location: "[City], TX" },
];
---

<Layout
  title="Home"
  description="Bee Unique is a Texas-based nonprofit helping youth discover their strengths, build confidence, and become who they were created to be through mentorship and community programs."
>
  <!-- Hero -->
  <section class="honeycomb-bg overflow-hidden">
    <Container class="grid grid-cols-1 items-center gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:py-28">
      <div>
        <Eyebrow>A Texas-Based Nonprofit</Eyebrow>
        <h1 class="mt-5 font-display text-4xl font-semibold leading-tight text-charcoal sm:text-5xl lg:text-6xl">
          Helping Texas youth discover their strengths, build confidence, and become who they were created to be.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-charcoal/75">
          Bee Unique accomplishes that mission through mentorship, leadership workshops, and community partnerships
          across Texas — helping every young person recognize what makes them unique.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/get-involved" size="lg">Get Involved</Button>
          <Button href="/donate" variant="outline" size="lg">Donate</Button>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <HoneycombArt class="w-full drop-shadow-xl" />
        <p class="mt-3 text-center text-xs text-charcoal/40 lg:text-left">
          [Placeholder — replace with real program photography]
        </p>
      </div>
    </Container>
  </section>

  <!-- Overview -->
  <section class="py-16 sm:py-20">
    <Container class="grid grid-cols-1 gap-10 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="font-display text-3xl font-semibold text-charcoal">Who We Are</h2>
      </div>
      <div class="lg:col-span-2">
        <p class="text-lg leading-relaxed text-charcoal/75">
          Bee Unique is a Texas-based 501(c)(3) nonprofit serving youth ages [8–18] across [service-area cities and
          communities]. We believe every young person carries strengths worth discovering — and that community,
          mentorship, and opportunity are what help those strengths grow. Like a hive, we work together: mentors,
          families, schools, and partners, each contributing something unique to a shared purpose.
        </p>
      </div>
    </Container>
  </section>

  <!-- Programs preview -->
  <section class="honeycomb-bg py-16 sm:py-20">
    <Container>
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <Eyebrow>Our Programs</Eyebrow>
          <h2 class="mt-4 font-display text-3xl font-semibold text-charcoal sm:text-4xl">
            Ways We Help Young People Thrive
          </h2>
        </div>
        <a href="/programs" class="text-sm font-semibold text-honey-dark hover:text-honey whitespace-nowrap">
          View all programs →
        </a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
        {programs.map((p) => <ProgramCard {...p} />)}
      </div>
    </Container>
  </section>

  <!-- Impact stats -->
  <section class="py-16 sm:py-20">
    <Container>
      <div class="text-center">
        <Eyebrow>Our Impact</Eyebrow>
        <h2 class="mt-4 font-display text-3xl font-semibold text-charcoal sm:text-4xl">Growing Together, Texas-Wide</h2>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <StatCard value="[250+]" label="Youth Served" />
        <StatCard value="[30+]" label="Workshops Hosted" />
        <StatCard value="[500+]" label="Volunteer Hours" />
        <StatCard value="[12]" label="Community Partners" />
      </div>
      <p class="mt-4 text-center text-xs text-charcoal/40">
        [Placeholder figures — replace with confirmed program data before publishing]
      </p>
    </Container>
  </section>

  <!-- Testimonial -->
  <section class="py-16 sm:py-20">
    <Container>
      <Testimonial
        quote="[Bee Unique gave my daughter a mentor who believed in her before she believed in herself. She's a different kid now — confident, curious, and proud of who she is.]"
        name="[Parent Name]"
        role="[Parent of a program participant]"
      />
    </Container>
  </section>

  <!-- Upcoming events -->
  <section class="honeycomb-bg py-16 sm:py-20">
    <Container>
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <Eyebrow>What's Next</Eyebrow>
          <h2 class="mt-4 font-display text-3xl font-semibold text-charcoal sm:text-4xl">Upcoming Events</h2>
        </div>
        <a href="/events" class="text-sm font-semibold text-honey-dark hover:text-honey whitespace-nowrap">
          See all events →
        </a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {
          events.map((e) => (
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-charcoal/5">
              <p class="text-xs font-bold uppercase tracking-wider text-teal">{e.date}</p>
              <p class="mt-2 font-display text-lg font-semibold text-charcoal">{e.title}</p>
              <p class="mt-1 text-sm text-charcoal/60">{e.location}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <CTABand
    heading="Every Young Person Has Something Unique to Offer"
    body="Whether you volunteer an afternoon, mentor a student for a season, or give what you can — you help build the hive that helps Texas youth thrive."
  />
</Layout>
