---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProgramCard from "../components/ProgramCard.astro";
import CTABand from "../components/CTABand.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import VideoCard from "../components/VideoCard.astro";
import SponsorBand from "../components/SponsorBand.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import Testimonials from "../components/Testimonials.astro";
import ImpactStats from "../components/ImpactStats.astro";
import Lightbox from "../components/Lightbox.astro";
import { site, programIncludes } from "../site";

/**
 * Quick links under the hero buttons, so Donate, Volunteer, Sponsor and Get
 * Involved are all reachable within the first screen, per Mike's feedback
 * (Aug 2026). Donate and Get Involved are the two hero buttons; these three
 * cover the rest without a second row of equally weighted buttons.
 */
const heroQuickLinks = [
  { href: "/get-involved#volunteer", label: "Volunteer", icon: "volunteer" as const },
  { href: "/get-involved#partner", label: "Sponsor", icon: "partner" as const },
  { href: "/programs", label: "Explore Programs", icon: "campus" as const },
];

const programs = [
  {
    name: "College Tours & Campus Visits",
    audience: "Exposure",
    icon: "campus" as const,
    description:
      "Students visit top colleges and universities, walk the campuses, and talk with current students and staff about what the experience is really like.",
  },
  {
    name: "College Readiness Workshops",
    audience: "Preparation",
    icon: "workshop" as const,
    description:
      "Practical sessions on admissions, financial aid, and scholarships, so students and families know the steps long before senior year.",
  },
  {
    name: "Mentorship & Personalized Support",
    audience: "Consistency",
    icon: "mentor" as const,
    description:
      "Ongoing mentorship and one to one guidance that stays with a student through the whole process, not just a single event.",
  },
];

const included = [
  { icon: "campus" as const, text: "Campus visits to top colleges & universities" },
  { icon: "talk" as const, text: "Real talk with college students & staff" },
  { icon: "scholarship" as const, text: "Scholarship, financial aid & admissions info" },
  { icon: "workshop" as const, text: "College readiness workshops" },
  { icon: "spark" as const, text: "Empowerment sessions + leadership activities" },
];

const trust = [
  { icon: "donate" as const, label: "Free for students", detail: "Every program, no cost" },
  { icon: "campus" as const, label: "Real campuses", detail: "Not a brochure" },
  { icon: "scholarship" as const, label: "Scholarships", detail: "And resources provided" },
  { icon: "mentor" as const, label: "Ongoing support", detail: "Not a one off event" },
];

const steps = [
  {
    n: "01",
    title: "Get on a campus",
    body: "We take students to see universities in person: the halls, the dorms, the people. Ambition needs something concrete to attach itself to.",
  },
  {
    n: "02",
    title: "Learn how it actually works",
    body: "Admissions requirements, deadlines, financial aid, scholarship searching. The process stops being a mystery, well before senior year.",
  },
  {
    n: "03",
    title: "Keep someone in your corner",
    body: "Mentors stay with a student through applications and decisions, so the plan survives contact with a hard week.",
  },
];
---

<Layout
  title="Home"
  description="Bee Unique is a 501(c)(3) nonprofit empowering youth through mentorship, education, and meaningful opportunities: college readiness, college tours, scholarships and community outreach, at no cost to students."
>
  <!-- ── Hero ───────────────────────────────────────────────────────── -->
  <section class="honeycomb-bg relative overflow-hidden border-b border-line">
    <Container class="relative grid grid-cols-1 items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.02fr_1fr] lg:py-24">
      <div class="relative z-10">
        <Eyebrow>501(c)(3) Nonprofit &middot; {site.serviceArea}</Eyebrow>
        <h1 class="mt-5 font-display text-[2.6rem] font-extrabold leading-[1.02] tracking-[-0.03em] text-ink sm:text-6xl lg:text-[4.2rem]">
          Bee-lieve<br />
          <span class="text-brand-strong">&amp;</span> Achieve
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
          Bee Unique empowers youth through mentorship, education, and meaningful opportunities, helping students
          recognize their potential, prepare for their future, and confidently pursue higher education and career
          goals.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/donate" size="lg">Donate</Button>
          <Button href="/get-involved" variant="outline" size="lg">Get Involved</Button>
        </div>
        <ul class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
          {
            heroQuickLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-strong hover:text-brand-deep"
                >
                  <Icon name={l.icon} size={16} class="shrink-0" />
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 flex items-center gap-2.5 text-sm font-semibold text-brand-deep">
          <Icon name="check" size={19} class="shrink-0" />
          Every program is offered at no cost to participating students.
        </p>
      </div>

      <div class="mx-auto w-full max-w-[26rem] sm:max-w-[30rem] lg:max-w-[34rem]">
        <div class="relative">
          <!--
            Decorative honeycomb cells behind the video, echoing the logo mark
            and the mosaic this hero used to be. Purely ornamental: aria-hidden,
            no interaction, and the video card sits above them (z-10) so they
            only ever peek out from behind its corners, never cover the footage.
            This inner wrapper holds only the video, so the offsets below are
            relative to the video card itself, not the caption underneath it.
          -->
          <svg
            class="pointer-events-none absolute -right-6 -top-7 h-24 w-24 text-brand/25 sm:-right-9 sm:-top-9 sm:h-32 sm:w-32"
            viewBox="0 0 100 100"
            aria-hidden="true"
          >
            <polygon points="50,3 93,26 93,74 50,97 7,74 7,26" fill="currentColor" />
          </svg>
          <svg
            class="pointer-events-none absolute -bottom-6 -left-5 h-16 w-16 text-brand-strong/40 sm:-bottom-8 sm:-left-7 sm:h-20 sm:w-20"
            viewBox="0 0 100 100"
            fill="none"
            aria-hidden="true"
          >
            <polygon points="50,4 92,27 92,73 50,96 8,73 8,27" stroke="currentColor" stroke-width="5" />
          </svg>

          <VideoCard
            src="/video/elevate-youth.mp4"
            poster="/images/elevate-youth-poster.webp"
            label="Bee Unique at the Elevate Youth Bastrop County education conference: Monique Grant presenting to a full room of students on the energy and reach of the program"
            preload="auto"
            class="relative z-10 aspect-[3/4] w-full rounded-[2rem] shadow-xl shadow-brand/10"
          />
        </div>
        <p class="mt-4 flex items-center justify-center gap-2 text-xs font-semibold text-ink-soft lg:justify-start">
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M4.5 3.5 8.5 6l-4 2.5Z" stroke-linejoin="round"></path>
            <circle cx="6" cy="6" r="4.9"></circle>
          </svg>
          A moment from a Bee Unique event: the energy, and Monique with the students
        </p>
      </div>
    </Container>
  </section>

  <SponsorBand />

  <!-- ── Trust strip ────────────────────────────────────────────────── -->
  <section class="border-b border-line bg-white">
    <Container>
      <ul class="grid grid-cols-2 divide-line lg:grid-cols-4 lg:divide-x">
        {
          trust.map((t) => (
            <li class="reveal flex items-center gap-3.5 border-b border-line px-1 py-6 lg:border-b-0 lg:px-6 lg:first:pl-0 lg:last:pr-0">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-tint text-brand-strong">
                <Icon name={t.icon} size={21} />
              </span>
              <span>
                <span class="block font-display text-sm font-bold text-ink">{t.label}</span>
                <span class="block text-xs text-ink-soft">{t.detail}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <ImpactStats class="border-b border-line" />

  <!-- ── Mission ────────────────────────────────────────────────────── -->
  <section class="py-16 sm:py-24">
    <Container class="grid grid-cols-1 gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <SectionHeading eyebrow="Our Mission" title="Your gateway to success" class="reveal" />
      <div class="reveal">
        <p class="font-display text-2xl font-semibold leading-snug text-ink sm:text-[1.75rem]">
          To expose, educate, and equip students with the tools they need for a successful college journey.
        </p>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">
          We provide ongoing mentorship, personalized support, and key resources to help students get accepted and
          prepared for college life. Don't wait until senior year to plan your future. Now is the time to dream,
          prepare, and achieve.
        </p>
      </div>
    </Container>
  </section>

  <!-- ── Programs ───────────────────────────────────────────────────── -->
  <section class="honeycomb-bg border-y border-line py-16 sm:py-24">
    <Container>
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading eyebrow="What We Do" title="Ways we help students thrive" class="reveal" />
        <a
          href="/programs"
          class="reveal group inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap text-sm font-semibold text-brand-strong hover:text-brand-deep"
        >
          View all programs
          <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {programs.map((p) => <ProgramCard {...p} class="reveal" />)}
      </div>
    </Container>
  </section>

  <!-- ── How it works ───────────────────────────────────────────────── -->
  <section class="py-16 sm:py-24">
    <Container>
      <SectionHeading
        eyebrow="How It Works"
        title="Exposure, then preparation, then someone who stays"
        class="reveal max-w-2xl"
      />
      <ol class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          steps.map((s) => (
            <li class="reveal relative border-t-2 border-brand/30 pt-6">
              <span class="font-display text-4xl font-extrabold text-brand/35">{s.n}</span>
              <h3 class="mt-2 font-display text-xl font-bold text-ink">{s.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <!-- ── What's included ────────────────────────────────────────────── -->
  <section class="honeycomb-bg border-y border-line py-16 sm:py-24">
    <Container class="grid grid-cols-1 items-center gap-14 lg:grid-cols-2">
      <div class="reveal order-2 lg:order-1">
        <SectionHeading eyebrow="The Bee Unique Program" title="What's included" />
        <ul class="mt-9 space-y-3">
          {
            included.map((item) => (
              <li class="flex items-center gap-4 rounded-xl border border-line bg-white px-5 py-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-tint text-brand-strong">
                  <Icon name={item.icon} size={19} />
                </span>
                <span class="text-[0.95rem] font-medium leading-snug text-ink">{item.text}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 rounded-2xl border-l-4 border-brand bg-brand-tint p-6">
          <p class="font-display text-lg font-bold text-brand-deep">Scholarships &amp; resources provided</p>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">
            Participation is free. Bee Unique covers the cost so a student's family budget is never the reason they
            miss out on the trip, the workshop, or the information.
          </p>
        </div>
      </div>

      <div class="reveal order-1 lg:order-2">
        <div class="mx-auto max-w-md overflow-hidden rounded-[1.75rem] border border-line shadow-xl shadow-brand/10">
          <Photo
            name="program-flyer"
            alt="Bee Unique program flyer: Bee-lieve and Achieve, Join the Bee Unique Program, your gateway to success"
            sizes="(min-width: 1024px) 440px, 100vw"
            class="w-full"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- ── Gallery ────────────────────────────────────────────────────── -->
  <section class="py-16 sm:py-24">
    <Container>
      <SectionHeading eyebrow="In the Community" title="Moments from the hive" class="reveal max-w-2xl">
        College tours, readiness workshops, community outreach and back to school drives. Tap any photo or clip to
        see it full size.
      </SectionHeading>
      <GalleryGrid class="reveal mt-12" initial={8} />
    </Container>
  </section>

  <!-- ── Testimonials ───────────────────────────────────────────────── -->
  <section class="honeycomb-bg border-y border-line py-16 sm:py-24">
    <Container>
      <SectionHeading eyebrow="In Their Words" title="What families say" align="center" class="reveal mb-12" />
      <div class="reveal">
        <Testimonials />
      </div>
    </Container>
  </section>

  <CTABand
    heading="Every student has something unique to offer"
    body="Volunteer, mentor a student, donate, sponsor a program or event, or partner with us. Every contribution helps us reach more students with the resources and experiences they need to thrive."
    primaryLabel="Get Involved"
    primaryHref="/get-involved"
  />

  <Lightbox />
</Layout>
