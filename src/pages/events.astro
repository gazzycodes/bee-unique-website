---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import CTABand from "../components/CTABand.astro";
import Photo from "../components/Photo.astro";
import VideoCard from "../components/VideoCard.astro";
import { site } from "../site";

/** Upcoming events — replace with real dates and locations as they're confirmed. */
const upcoming: { date: string; title: string; location: string; detail: string }[] = [];

const past = [
  {
    title: "College Tour",
    detail:
      "Students visited college campuses, met current students and staff, and got a first-hand look at university life.",
    media: { type: "photo", name: "college-tour-campus", alt: "Bee Unique students outside a university stadium during a college tour" },
  },
  {
    title: "Back2School Community Event",
    detail:
      "Free backpacks, school supplies and haircuts for students heading into the new school year, run with local volunteers and partners.",
    media: {
      type: "video",
      src: "/video/back2school.mp4",
      poster: "/images/back2school-poster.webp",
      alt: "Bee Unique Back2School community event with free supplies and haircuts",
    },
  },
  {
    title: "Elevate Youth — Bastrop County",
    detail:
      "Bee Unique joined educators and community organisations at a regional conference on building pathways to success for students.",
    media: { type: "photo", name: "elevate-youth", alt: "Elevate Youth Bastrop County conference presentation" },
  },
];
---

<Layout
  title="Events"
  description="College tours, readiness workshops and community events from Bee Unique — what's coming up and what we've been part of."
>
  <section class="honeycomb-bg border-b border-line">
    <Container class="py-14 sm:py-16">
      <Eyebrow>Events</Eyebrow>
      <h1 class="mt-5 font-display text-4xl font-extrabold text-ink sm:text-5xl">What's coming up</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
        College tours, readiness workshops, empowerment sessions and community outreach days.
      </p>
    </Container>
  </section>

  <section class="py-16 sm:py-20">
    <Container>
      {
        upcoming.length > 0 ? (
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {upcoming.map((e) => (
              <div class="rounded-2xl border border-line bg-white p-6">
                <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand-strong">{e.date}</p>
                <h2 class="mt-2 font-display text-lg font-bold text-ink">{e.title}</h2>
                <p class="mt-1 text-sm text-ink-soft">{e.location}</p>
                <p class="mt-3 text-sm leading-relaxed text-ink-soft">{e.detail}</p>
              </div>
            ))}
          </div>
        ) : (
          <div class="rounded-2xl border border-line bg-mist p-8 sm:p-10">
            <h2 class="font-display text-xl font-bold text-ink">Next dates are being confirmed</h2>
            <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
              We're finalising the next round of college tours and workshops. Join the mailing list in the footer, or
              follow{" "}
              {site.socials.map((s) => (
                <a href={s.href} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-strong hover:text-brand-deep">
                  {s.handle}
                </a>
              ))}
              on Instagram — dates go up there first. To ask about a specific program, email{" "}
              <a href={`mailto:${site.email}`} class="font-semibold text-brand-strong hover:text-brand-deep">
                {site.email}
              </a>
              .
            </p>
          </div>
        )
      }
    </Container>
  </section>

  <section class="honeycomb-bg border-y border-line py-16 sm:py-20">
    <Container>
      <Eyebrow>Recently</Eyebrow>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink sm:text-4xl">Where we've been</h2>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          past.map((p) => (
            <article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-white">
              {p.media.type === "video" ? (
                <VideoCard src={p.media.src!} poster={p.media.poster!} label={p.media.alt} class="h-56 rounded-none border-0 border-b border-line" />
              ) : (
                <Photo name={p.media.name!} alt={p.media.alt} sizes="(min-width: 768px) 33vw, 100vw" class="h-56 w-full object-cover" />
              )}
              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-display text-lg font-bold text-ink">{p.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{p.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <CTABand
    heading="Want Bee Unique at your school or event?"
    body="We partner with schools, districts and community organisations to bring college readiness directly to students."
    primaryLabel="Start a Partnership"
    primaryHref="/get-involved#partner"
  />
</Layout>
