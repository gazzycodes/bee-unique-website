---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import FormField from "../components/FormField.astro";
---

<Layout title="Contact" description="Get in touch with Bee Unique — questions about programs, partnerships, or how to get involved.">
  <section class="honeycomb-bg">
    <Container class="py-16 sm:py-20 lg:py-24">
      <Eyebrow>Contact</Eyebrow>
      <h1 class="mt-5 max-w-2xl font-display text-4xl font-semibold leading-tight text-charcoal sm:text-5xl">
        We'd Love to Hear From You
      </h1>
    </Container>
  </section>

  <section class="py-16 sm:py-20">
    <Container class="grid grid-cols-1 gap-12 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <h2 class="font-display text-2xl font-semibold text-charcoal">Reach Us Directly</h2>
        <dl class="mt-6 space-y-4 text-sm text-charcoal/75">
          <div>
            <dt class="font-semibold text-charcoal">Email</dt>
            <dd><a href="mailto:[info@beeunique.org]" class="hover:text-honey-dark">[info@beeunique.org]</a></dd>
          </div>
          <div>
            <dt class="font-semibold text-charcoal">Phone</dt>
            <dd><a href="tel:[555-555-5555]" class="hover:text-honey-dark">[(555) 555-5555]</a></dd>
          </div>
          <div>
            <dt class="font-semibold text-charcoal">Service Area</dt>
            <dd>[City / region], Texas</dd>
          </div>
          <div>
            <dt class="font-semibold text-charcoal">Mailing Address</dt>
            <dd>[Street Address], [City], TX [ZIP]</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-3">
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="grid grid-cols-1 gap-4 rounded-2xl bg-white p-7 shadow-sm ring-1 ring-charcoal/5 sm:grid-cols-2 sm:p-8"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
          <FormField label="Full Name" name="name" required />
          <FormField label="Email" name="email" type="email" required />
          <FormField
            label="Reason for Contact"
            name="reason"
            type="select"
            options={["Program question", "Volunteering", "Partnership", "Media inquiry", "Other"]}
            class="sm:col-span-2"
          />
          <FormField label="Message" name="message" type="textarea" required class="sm:col-span-2" />
          <button
            type="submit"
            class="sm:col-span-2 mt-2 inline-flex items-center justify-center rounded-full bg-honey px-6 py-3 text-sm font-semibold text-charcoal transition-colors hover:bg-honey-dark"
          >
            Send Message
          </button>
        </form>
      </div>
    </Container>
  </section>
</Layout>
