---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PersonCard from "../components/PersonCard.astro";
import CTABand from "../components/CTABand.astro";

const values = [
  { title: "Community", desc: "We grow stronger when we work together — like a hive, no single person carries the mission alone." },
  { title: "Purpose", desc: "Every young person deserves to understand their strengths and how those strengths can serve others." },
  { title: "Growth", desc: "Confidence and skill are built through consistent support, not a single event." },
  { title: "Contribution", desc: "We believe young people don't just need help — they have something valuable to give back." },
];

const leadership = [
  { name: "[Founder Name]", role: "Founder & Executive Director" },
  { name: "[Name]", role: "Program Director" },
  { name: "[Name]", role: "Community Partnerships" },
];

const board = [
  { name: "[Board Member Name]", role: "Board Chair" },
  { name: "[Board Member Name]", role: "Treasurer" },
  { name: "[Board Member Name]", role: "Secretary" },
  { name: "[Board Member Name]", role: "Board Member" },
];

const partners = ["[Partner Org]", "[Partner Org]", "[Local School District]", "[Community Center]", "[Partner Org]", "[Corporate Sponsor]"];
---

<Layout
  title="About Us"
  description="Learn the story, mission, and people behind Bee Unique — a Texas-based nonprofit helping youth discover their strengths and build confidence."
>
  <!-- Story -->
  <section class="honeycomb-bg">
    <Container class="grid grid-cols-1 gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:py-24">
      <div>
        <Eyebrow>Our Story</Eyebrow>
        <h1 class="mt-5 font-display text-4xl font-semibold leading-tight text-charcoal sm:text-5xl">
          Why Bee Unique Exists
        </h1>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-charcoal/75">
        <p>
          [Bee Unique started when our founder saw a gap: young people across Texas with real potential, but without
          consistent mentorship, encouragement, or a community that helped them see their own strengths. Bee Unique
          was built to close that gap — one relationship, one workshop, one community at a time.]
        </p>
        <p>
          Like a hive, we believe no one builds something meaningful alone. Every mentor, volunteer, partner, and
          family that joins Bee Unique brings something unique — together, that's what makes the whole hive stronger.
        </p>
      </div>
    </Container>
  </section>

  <!-- Mission / Vision -->
  <section class="py-16 sm:py-20">
    <Container class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-charcoal/5 sm:p-10">
        <h2 class="font-display text-2xl font-semibold text-charcoal">Our Mission</h2>
        <p class="mt-4 leading-relaxed text-charcoal/75">
          To help Texas youth ages [8–18] discover their strengths, build confidence, and develop the skills needed
          to thrive in school, leadership, and life through mentorship, enrichment, and community partnerships.
        </p>
      </div>
      <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-charcoal/5 sm:p-10">
        <h2 class="font-display text-2xl font-semibold text-charcoal">Our Vision</h2>
        <p class="mt-4 leading-relaxed text-charcoal/75">
          A Texas where every young person has access to a mentor, a community, and the confidence to recognize what
          makes them unique — and the opportunity to use it.
        </p>
      </div>
    </Container>
  </section>

  <!-- Values -->
  <section class="honeycomb-bg py-16 sm:py-20">
    <Container>
      <Eyebrow>What We Stand On</Eyebrow>
      <h2 class="mt-4 font-display text-3xl font-semibold text-charcoal sm:text-4xl">Our Core Values</h2>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v) => (
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-charcoal/5">
              <h3 class="font-display text-lg font-semibold text-honey-dark">{v.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-charcoal/70">{v.desc}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Who we serve / why Texas -->
  <section class="py-16 sm:py-20">
    <Container class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-semibold text-charcoal">Who We Serve</h2>
        <p class="mt-4 leading-relaxed text-charcoal/75">
          We serve youth ages [8–18] and their families in [service-area cities/regions], with a focus on
          communities where access to consistent mentorship and enrichment programming is limited.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-semibold text-charcoal">Why This Work Matters Across Texas</h2>
        <p class="mt-4 leading-relaxed text-charcoal/75">
          [Texas is home to some of the fastest-growing youth populations in the country, and demand for
          mentorship and enrichment programming continues to outpace availability.] Bee Unique exists to help close
          that gap, one community at a time.
        </p>
      </div>
    </Container>
  </section>

  <!-- Leadership message -->
  <section class="honeycomb-bg py-16 sm:py-20">
    <Container class="mx-auto max-w-3xl text-center">
      <Eyebrow>From Our Founder</Eyebrow>
      <blockquote class="mt-6 font-display text-2xl font-medium leading-relaxed text-charcoal sm:text-3xl">
        "[We started Bee Unique because every young person we met had something special to offer — they just needed
        someone to help them see it. That's still what drives us today.]"
      </blockquote>
      <p class="mt-6 text-sm font-semibold text-charcoal/60">[Founder Name], Founder & Executive Director</p>
    </Container>
  </section>

  <!-- Leadership & Board -->
  <section class="py-16 sm:py-20">
    <Container>
      <Eyebrow>Our People</Eyebrow>
      <h2 class="mt-4 font-display text-3xl font-semibold text-charcoal sm:text-4xl">Leadership Team</h2>
      <div class="mt-10 grid grid-cols-2 gap-8 sm:grid-cols-3">
        {leadership.map((p) => <PersonCard {...p} />)}
      </div>

      <h2 class="mt-16 font-display text-3xl font-semibold text-charcoal sm:text-4xl">Board of Directors</h2>
      <div class="mt-10 grid grid-cols-2 gap-8 sm:grid-cols-4">
        {board.map((p) => <PersonCard {...p} />)}
      </div>
    </Container>
  </section>

  <!-- Partners -->
  <section class="honeycomb-bg py-16 sm:py-20">
    <Container>
      <Eyebrow>Working Together</Eyebrow>
      <h2 class="mt-4 font-display text-3xl font-semibold text-charcoal sm:text-4xl">Community Partners</h2>
      <div class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
        {
          partners.map((p) => (
            <div class="flex h-20 items-center justify-center rounded-xl bg-white px-4 text-center text-sm font-semibold text-charcoal/50 shadow-sm ring-1 ring-charcoal/5">
              {p}
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-charcoal/40">[Partner logos to be added with permission]</p>
    </Container>
  </section>

  <CTABand
    heading="Meet the People Behind the Mission"
    body="Want to be part of the hive? Explore ways to volunteer, mentor, or partner with Bee Unique."
    primaryLabel="Get Involved"
    primaryHref="/get-involved"
  />
</Layout>
