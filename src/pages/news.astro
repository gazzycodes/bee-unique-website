---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import CTABand from "../components/CTABand.astro";
import { site } from "../site";

const ig = site.socials[0];
---

<Layout
  title="News"
  description="Updates, stories and announcements from Bee Unique: college tours, student milestones and community outreach."
>
  <section class="honeycomb-bg border-b border-line">
    <Container class="py-14 sm:py-16">
      <Eyebrow>News</Eyebrow>
      <h1 class="mt-5 font-display text-4xl font-extrabold text-ink sm:text-5xl">Updates from the hive</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Student milestones, program news and announcements.
      </p>
    </Container>
  </section>

  <section class="py-16 sm:py-20">
    <Container class="mx-auto max-w-3xl">
      <div class="rounded-2xl border border-line bg-mist p-8 sm:p-10">
        <h2 class="font-display text-xl font-bold text-ink">Nothing posted here yet</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          We'd rather leave this empty than fill it with filler. In the meantime, the most current updates go up on
          Instagram at{" "}
          <a href={ig.href} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-strong hover:text-brand-deep">{ig.handle}</a>{" "}
          and program news goes out to the mailing list first. Sign up in the footer.
        </p>
        <p class="mt-4 text-sm text-ink-soft">
          Media inquiries:{" "}
          <a href={`mailto:${site.email}`} class="font-semibold text-brand-strong hover:text-brand-deep">
            {site.email}
          </a>
        </p>
      </div>
    </Container>
  </section>

  <CTABand
    heading="Follow along"
    body="The fastest way to hear about the next college tour or workshop is the mailing list and Instagram."
    primaryLabel="Get Involved"
    primaryHref="/get-involved"
  />
</Layout>
