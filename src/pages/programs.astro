---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ProgramDetail from "../components/ProgramDetail.astro";
import CTABand from "../components/CTABand.astro";
import Photo from "../components/Photo.astro";
import VideoCard from "../components/VideoCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import SponsorBand from "../components/SponsorBand.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import Testimonials from "../components/Testimonials.astro";
import Lightbox from "../components/Lightbox.astro";

const included = [
  { icon: "campus", text: "Campus visits to top colleges & universities" },
  { icon: "talk", text: "Real talk with college students & staff" },
  { icon: "scholarship", text: "Scholarship, financial aid & admissions info" },
  { icon: "workshop", text: "College readiness workshops" },
  { icon: "spark", text: "Empowerment sessions + leadership activities" },
];

const programs = [
  {
    name: "College Tours & Campus Visits",
    icon: "campus",
    summary:
      "Students travel to top colleges and universities, walk the campuses, sit in on the spaces they'd actually study in, and get honest answers from current students and staff. For many, it's the first time a university stops being an abstraction.",
    outcome:
      "A concrete sense of where they could go, what campus life is like, and which schools actually fit them, plus the questions they didn't know to ask.",
    photo: "college-tour-campus",
    photoAlt: "Bee Unique students on a college tour outside a university stadium entrance",
    photoFocus: "object-[50%_55%]",
    facts: [
      { label: "Format", value: "Group campus visits" },
      { label: "Includes", value: "Travel, meals & materials" },
      { label: "Cost to students", value: "Free" },
      { label: "How to join", value: "Register via Get Involved" },
    ],
  },
  {
    name: "College Readiness Workshops",
    icon: "workshop",
    summary:
      "Working sessions on admissions requirements, application timelines, financial aid, and scholarship searching, for students and, where possible, their families. The point is to make the process legible early, not to cram it into senior year.",
    outcome:
      "A student who knows the deadlines, understands what aid they qualify for, and has a plan rather than a panic.",
    facts: [
      { label: "Format", value: "Workshops & group sessions" },
      { label: "Covers", value: "Admissions, aid, scholarships" },
      { label: "Cost to students", value: "Free" },
      { label: "How to join", value: "Register via Get Involved" },
    ],
  },
  {
    name: "Mentorship & Personalized Support",
    icon: "mentor",
    summary:
      "Ongoing mentorship and one-to-one guidance that follows a student through the process: reviewing applications, talking through choices, and staying in touch between events.",
    outcome:
      "A trusted adult in a student's corner, and the confidence that comes from having someone who knows their goals and checks in on them.",
    photo: "team-portrait",
    photoAlt: "Two members of the Bee Unique team at a community education event",
    photoFocus: "object-[50%_30%]",
    photoBox: "max-w-sm aspect-[4/5]",
    facts: [
      { label: "Format", value: "One-to-one & small group" },
      { label: "Commitment", value: "Ongoing through the journey" },
      { label: "Cost to students", value: "Free" },
      { label: "Become a mentor", value: "Apply via Get Involved" },
    ],
  },
  {
    name: "Scholarships & Resources",
    icon: "scholarship",
    summary:
      "Bee Unique provides scholarships and the practical resources students need along the way, so a family's budget is never the reason a student misses a trip, a workshop, or an application deadline.",
    outcome: "Fewer financial barriers between a student and the next step they've earned.",
    facts: [
      { label: "Provided", value: "Scholarships & resources" },
      { label: "Applies to", value: "Program participants" },
      { label: "Cost to students", value: "Free" },
      { label: "Details", value: "[Award amounts & criteria to confirm]" },
    ],
  },
  {
    name: "Empowerment & Leadership Sessions",
    icon: "spark",
    summary:
      "Sessions and activities built around confidence, self-advocacy, goal-setting and leadership. These are the parts of the college journey that aren't on any application form but decide how a student handles it.",
    outcome: "Students who can speak for themselves, set a goal and follow it, and see themselves as capable.",
    facts: [
      { label: "Format", value: "Empowerment sessions & activities" },
      { label: "Focus", value: "Confidence & leadership" },
      { label: "Cost to students", value: "Free" },
      { label: "How to join", value: "Register via Get Involved" },
    ],
  },
  {
    name: "Community Outreach",
    icon: "community",
    summary:
      "Bee Unique shows up in the community year-round: back-to-school drives with free supplies and haircuts, school and district events, and education conferences that connect families to what's available to them.",
    outcome: "Students and families reached where they already are, with real resources in hand.",
    photo: "outreach-table",
    photoAlt: "Students gathered around the Bee Unique information table at a school event",
    photoFocus: "object-[50%_38%]",
    facts: [
      { label: "Format", value: "Community events & drives" },
      { label: "Examples", value: "Back2School, school events" },
      { label: "Cost to families", value: "Free" },
      { label: "Sponsor an event", value: "Contact us" },
    ],
  },
];
---

<Layout
  title="Programs & Impact"
  description="Bee Unique provides college readiness, mentorship, scholarships, college tours, community outreach, and educational enrichment at no cost to participating students."
>
  <!-- Intro -->
  <section class="honeycomb-bg border-b border-line">
    <Container class="py-16 sm:py-20">
      <SectionHeading
        as="h1"
        eyebrow="Programs & Impact"
        title="Exposure, preparation, and someone in your corner"
        class="max-w-3xl"
      >
        Bee Unique provides college readiness, mentorship, scholarships, college tours, community outreach, and
        educational enrichment at no cost to participating students. Through hands-on experiences and consistent
        support, we help students expand their exposure, strengthen their confidence, and create a clear pathway
        toward success.
      </SectionHeading>
    </Container>
  </section>

  <SponsorBand />

  <!-- What's included summary -->
  <section class="py-14 sm:py-16">
    <Container>
      <h2 class="font-display text-2xl font-bold text-ink">Every participant gets</h2>
      <div class="section-divider mt-4"></div>
      <ul class="reveal mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          included.map((item) => (
            <li class="card-lift flex items-center gap-3.5 rounded-2xl border border-line bg-white p-5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-tint text-brand-strong">
                <Icon name={item.icon} size={20} />
              </span>
              <span class="text-sm font-medium leading-snug text-ink">{item.text}</span>
            </li>
          ))
        }
        <li class="flex items-start gap-3 rounded-2xl border-l-4 border-brand bg-brand-tint p-5">
          <span class="text-sm font-semibold leading-relaxed text-brand-deep">
            Scholarships &amp; resources provided, at no cost to students
          </span>
        </li>
      </ul>
    </Container>
  </section>

  <!-- Program detail -->
  <section class="honeycomb-bg border-y border-line py-16 sm:py-20">
    <Container class="space-y-16 sm:space-y-20">
      {programs.map((p, i) => <div class="reveal"><ProgramDetail {...p} reverse={i % 2 === 1} /></div>)}
    </Container>
  </section>

  <!-- Impact -->
  <section class="py-16 sm:py-20">
    <Container>
      <div class="max-w-2xl">
        <Eyebrow>Our Impact</Eyebrow>
        <h2 class="mt-4 font-display text-3xl font-bold text-ink sm:text-4xl">What impact looks like</h2>
        <p class="mt-4 leading-relaxed text-ink-soft">
          We publish numbers only once we can stand behind them. In the meantime, here's the work itself: students on
          campuses, families at community events, and a team that keeps showing up.
        </p>
        <p class="mt-3 text-sm text-ink-soft">
          [Verified impact figures to be added here: students served, tours hosted, scholarships awarded.]
        </p>
      </div>

      <GalleryGrid class="reveal mt-10" initial={8} showFilters={true} />
    </Container>
  </section>

  <!-- Testimonials -->
  <section class="honeycomb-bg border-t border-line py-16 sm:py-20">
    <Container>
      <SectionHeading eyebrow="In Their Words" title="What families say" align="center" class="reveal mb-12" />
      <div class="reveal">
        <Testimonials />
      </div>
    </Container>
  </section>

  <CTABand
    heading="Help us reach more students"
    body="Every program Bee Unique runs is free to the students who need it. Sponsoring a tour, mentoring a student, or giving what you can is what keeps it that way."
  />

  <Lightbox />
</Layout>
