---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
---

<Layout title="Privacy Policy" description="Bee Unique's privacy policy.">
  <section class="py-16 sm:py-20">
    <Container class="mx-auto max-w-3xl">
      <Eyebrow>Legal</Eyebrow>
      <h1 class="mt-5 font-display text-4xl font-semibold text-charcoal">Privacy Policy</h1>
      <p class="mt-3 text-sm text-charcoal/50">Last updated: [Month Day, Year]</p>

      <div class="mt-8 rounded-xl bg-honey/10 p-5 text-sm text-charcoal/75">
        [Draft placeholder — have this policy reviewed by legal counsel before publishing, and update all bracketed
        fields with your actual practices.]
      </div>

      <div class="mt-8 space-y-8 leading-relaxed text-charcoal/75">
        <div>
          <h2 class="font-display text-xl font-semibold text-charcoal">Information We Collect</h2>
          <p class="mt-2">
            We may collect information you provide directly, such as your name, email address, and phone number,
            when you fill out a form on this site (e.g., volunteering, mentorship applications, contact, or
            newsletter sign-up).
          </p>
        </div>
        <div>
          <h2 class="font-display text-xl font-semibold text-charcoal">How We Use Information</h2>
          <p class="mt-2">
            We use the information collected to respond to inquiries, process applications, send program or event
            updates you've opted into, and improve our programs. We do not sell your personal information.
          </p>
        </div>
        <div>
          <h2 class="font-display text-xl font-semibold text-charcoal">Children's Privacy</h2>
          <p class="mt-2">
            [Describe how information about program participants under 18 is collected, used, and protected,
            including any parental/guardian consent process.]
          </p>
        </div>
        <div>
          <h2 class="font-display text-xl font-semibold text-charcoal">Contact Us</h2>
          <p class="mt-2">
            Questions about this policy can be directed to <a href="mailto:[info@beeunique.org]" class="font-semibold text-honey-dark">[info@beeunique.org]</a>.
          </p>
        </div>
      </div>
    </Container>
  </section>
</Layout>
